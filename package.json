{
  "name": "keepsake",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preflight": "node tools/preflight/preflight.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node tools/readable-test-runner.mjs",
    "format:check": "prettier --check .",
    "web": "pnpm --filter @keepsake/web start",
    "api": "pnpm --filter @keepsake/api dev"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.69.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.86.2",
      "react-native-web": "^0.21.2"
    }
  }
}
