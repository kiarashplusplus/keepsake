{
  "name": "@keepsake/web",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "export": "expo export --platform web --clear && node scripts/verify-public-env.mjs && node scripts/fix-html-head.mjs && node scripts/write-version-json.mjs && node scripts/copy-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test e2e/support/*.test.mjs && jest",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@keepsake/contracts": "workspace:*",
    "@keepsake/tokens": "workspace:*",
    "blurhash": "^2.0.5",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.0",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~5.9.2"
  }
}
