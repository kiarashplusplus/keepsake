# Copy to `.dev.vars` for local `wrangler dev`. Never committed (see
# apps/api/.gitignore) — these are secrets, not [vars] in wrangler.toml, which
# only holds non-sensitive config per plan "Tooling, CI, deploy".

# Turnstile secret key for the domain, paired with the public site key the
# web app embeds. Verifies `cf-turnstile-response` on listing/request/report
# submission and email add/recover.
#
# M1: left blank here on purpose. `src/middleware/turnstile.ts` treats an
# unset secret as "pass every request through, log once" rather than 403ing
# every write — local dev and preview both run without it until the widget
# is provisioned for the domain (plan Risks). Set this before any deploy
# whose traffic should actually be checked; once it's set, verification is
# unconditionally enforced.
TURNSTILE_SECRET=

# Kiarash's one admin credential (Bearer <ADMIN_TOKEN>, constant-time
# compare). Admin is Kiarash alone — there is no admin account system.
ADMIN_TOKEN=

# Resend API key: fallback email provider behind the same `sendMail()`
# interface, used only if Cloudflare Email Service enablement or the
# keepsake.ing sender domain onboarding (plan Risks #1) isn't ready.
RESEND_API_KEY=

# Cloudflare API token scoped to `Zone.Cache Purge` on the keepsake.ing zone
# (issue #94). Paired with the `CF_ZONE_ID` var in wrangler.toml: with both
# set, `src/lib/photoCache.ts` purges a deleted photo's two variant URLs from
# every colo via POST /zones/:zone_id/purge_cache, not just from the colo
# that happened to execute the delete. Left blank here on purpose — with
# either half missing the zone purge is a silent no-op, the per-colo
# `caches.default.delete()` still runs, and `images.ts`'s `max-age=3600`
# bounds how long any unreached copy can survive. Local dev has no zone to
# purge against anyway.
CF_CACHE_PURGE_TOKEN=

# Read-only Cloudflare API token for the Observatory (GET
# /api/admin/observatory), scoped to exactly two account permission groups:
# `Account Analytics Read` and `Workers Observability Read`. Pairs with the
# `CF_ACCOUNT_ID`/`CF_SCRIPT_NAME` vars in wrangler.toml. Left blank here on
# purpose: local `wrangler dev` has no deployed script whose analytics or
# logs there would be anything to read, and the Observatory's D1-derived half
# — the funnel, the queue ages, the daily digest — works with no credential
# at all. With this unset the two Cloudflare panels render an explicit
# "not configured" rather than an empty chart.
CF_OBSERVATORY_TOKEN=

# Keys the per-recipient unsubscribe token (src/email/unsubscribe.ts):
# HMAC-SHA256(this, lowercased address), never a bare hash of the address —
# see that file's doc comment for why a token that's mailed out, unlike
# email_events.to_hash, needs to be keyed rather than just hashed.
#
# Left blank here on purpose, same posture as TURNSTILE_SECRET: unset means
# every unsubscribe/resubscribe URL falls back to the mailto: address the
# footer already names (sendMail.ts's withUnsubscribeLink), not a broken
# link and not a blocked send — the mechanism degrades to what #310's first
# pass shipped, it doesn't stop working. Set this before any deploy whose
# one-click unsubscribe should actually be one-click.
UNSUBSCRIBE_SECRET=

# Address the daily digest is mailed to (apps/api/src/cron/dailyDigest.ts).
# A secret rather than a wrangler.toml var only because it is a real
# person's address and that file is committed. Unset means the digest is
# still built every night — proving the queries work — and logged instead of
# sent, which is why the cron does not fail when this is blank.
ADMIN_DIGEST_TO=
