# Copy to `.dev.vars` for local `wrangler dev`. Never committed (see
# apps/api/.gitignore) — these are secrets, not [vars] in wrangler.toml, which
# only holds non-sensitive config per plan "Tooling, CI, deploy".

# Turnstile secret key for the domain, paired with the public site key the
# web app embeds. Verifies `cf-turnstile-response` on listing/request/report
# submission and email add/recover.
#
# M1: left blank here on purpose. `src/middleware/turnstile.ts` treats an
# unset secret as "pass every request through, log once" rather than 403ing
# every write — local dev and preview both run without it until the widget
# is provisioned for the domain (plan Risks). Set this before any deploy
# whose traffic should actually be checked; once it's set, verification is
# unconditionally enforced.
TURNSTILE_SECRET=

# Kiarash's one admin credential (Bearer <ADMIN_TOKEN>, constant-time
# compare). Admin is Kiarash alone — there is no admin account system.
ADMIN_TOKEN=

# Resend API key: fallback email provider behind the same `sendMail()`
# interface, used only if Cloudflare Email Service enablement or the
# keepsake.ing sender domain onboarding (plan Risks #1) isn't ready.
RESEND_API_KEY=

# Cloudflare API token scoped to `Zone.Cache Purge` on the keepsake.ing zone
# (issue #94). Paired with the `CF_ZONE_ID` var in wrangler.toml: with both
# set, `src/lib/photoCache.ts` purges a deleted photo's two variant URLs from
# every colo via POST /zones/:zone_id/purge_cache, not just from the colo
# that happened to execute the delete. Left blank here on purpose — with
# either half missing the zone purge is a silent no-op, the per-colo
# `caches.default.delete()` still runs, and `images.ts`'s `max-age=3600`
# bounds how long any unreached copy can survive. Local dev has no zone to
# purge against anyway.
CF_CACHE_PURGE_TOKEN=
