# Metro (Expo) resolves from a flat node_modules; pnpm's default isolated layout
# breaks its haste map and autolinking. Hoisted is the layout Expo documents.
node-linker=hoisted
shamefully-hoist=true
# Expo's SDK pins a matrix of peers that npm-published libraries lag behind;
# strict peers would block every install on a version-range nit.
strict-peer-dependencies=false
auto-install-peers=true
